# Copie este arquivo para ".env" (nunca commitado) e preencha com os valores reais.

# --- Origem dos screenshots (FTP ou sFTP) ---
SERVER=host:porta
USER=usuario
PASS=senha
SFTP_FOLDER=/caminho/no/servidor
SELECT_FTP_MODE=sftp          # sftp ou ftp

# Chave publica do servidor sFTP. Obrigatoria quando SELECT_FTP_MODE=sftp: sem
# ela o bot aceitaria qualquer servidor no endereco e entregaria a senha a um
# man-in-the-middle. Pegue com:
#   ssh-keyscan -p <porta> -t ed25519 <host>
# e confira a fingerprint (`| ssh-keygen -lf -`) de mais de um ponto de rede
# antes de confiar. Aceita tanto "ssh-ed25519 AAAA..." quanto a linha inteira
# do ssh-keyscan, com o prefixo "[host]:porta".
SFTP_HOST_KEY=ssh-ed25519 AAAA...
# SFTP_INSECURE_HOST_KEY=true  # desliga a verificacao (nao recomendado; loga aviso no boot)

# --- Discord ---
BOT_TOKEN=token-do-bot
CHANNEL_ID=id-do-canal
# DISCORD_GUILD_ID=id-do-servidor  # opcional: propaga os slash commands na hora nesse servidor (senão demora até 1h globalmente)

# --- Comportamento ---
WAITING_TIME=20                # minutos de espera quando não há screenshots novos (2-120, padrão 30)
SERVER_NAME=meu-servidor-bf4    # rótulo salvo na coluna "server" do índice (padrão: mesmo valor de SERVER)
DEBUG_MODE=false

# --- Avançado (defaults já definidos no docker-compose.yml, normalmente não precisa mexer) ---
# DB_PATH=/data/pbss.db
# TEMP_DIR=/data/tmp
# RETENTION_HOURS=24

# Dead-man switch opcional: URL de push de um monitor do Uptime Kuma. O bot bate
# nela a cada 5 min enquanto o gateway do Discord estiver conectado, entao o
# monitor cai sozinho se o processo morrer ou perder a conexao.
# Mora aqui, e nao no docker-compose.yml, porque o token faz parte da URL e o
# compose e' versionado.
# KUMA_PUSH_URL=http://uptime-kuma:3001/api/push/SEU_TOKEN
